[Unit]
Description=WSS mux relay for Telegram Desktop
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=nobody
Group=nobody
WorkingDirectory=/opt/wss-relay
ExecStart=/opt/wss-relay/bin/wss-relay \
	-listen 127.0.0.1:8283 \
	-mux-path /ws/mux \
	-max-streams 64 \
	-max-tunnels-per-ip 0 \
	-stream-idle-timeout 10m \
	-ws-ping-interval 30s \
	-ws-read-timeout 90s \
	-upstream-stall-rotate 4 \
	-telegram-only=true \
	-upstream-pool-min 2 \
	-upstream-pool-max 15 \
	-upstream-pool-idle 60s \
	-upstream-pool-bucket-retention 10m \
	-upstream-pool-target-hit 40 \
	-egress-bind-ips 31.76.21.175,31.76.21.176,31.76.21.177 \
	-auth-file /opt/wss-relay/config/tokens
Restart=always
RestartSec=5
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
ReadWritePaths=/tmp

[Install]
WantedBy=multi-user.target
